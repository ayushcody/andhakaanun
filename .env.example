# ──────────────────────────────────────────────
# AndhaKaanun LegalAI — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# Application
APP_NAME=AndhaKaanun LegalAI
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development

# Groq (LLM Provider — free tier, no quota issues)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Models your key can use: GET https://api.groq.com/openai/v1/models
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Pinecone (Vector Store)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=andhakaanun-legal
PINECONE_ENV=us-east-1-aws

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://andhakaanun:password@localhost:5432/andhakaanun

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_HOUR=10

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
